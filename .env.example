# Ollama (local default)
WORDPILOT_LLM_PROVIDER=ollama
WORDPILOT_LLM_MODEL=qwen2.5:7b
WORDPILOT_OLLAMA_BASE_URL=http://localhost:11434
WORDPILOT_LLM_TIMEOUT_SECONDS=30

# Groq API: switch provider to groq. Groq has its own model setting so Ollama's
# model configuration cannot affect it. Set the key in local .env; never commit it.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
