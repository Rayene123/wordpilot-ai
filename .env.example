# Demonstrated WordPilot provider: Groq.
# Replace the placeholder with a Groq API key; never commit a real key.
WORDPILOT_LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your-groq-api-key

# Optional local alternative: comment out the Groq provider line above, then
# uncomment the Ollama provider and model below. Local inference needs adequate
# CPU, RAM and/or GPU resources; model performance depends on host hardware.
# WORDPILOT_LLM_PROVIDER=ollama
# WORDPILOT_LLM_MODEL=qwen2.5:7b
# WORDPILOT_OLLAMA_BASE_URL=http://localhost:11434
